# Copy to backend/.env. Every setting is optional.
AETHER_OLLAMA_URL=http://localhost:11434
AETHER_MODEL=qwen2.5:7b
AETHER_EMBED_MODEL=nomic-embed-text
AETHER_MAX_STEPS=8
AETHER_CONTEXT_LENGTH=16384
AETHER_TEMPERATURE=0.2
# Let reasoning models (qwen3, deepseek-r1) think out loud. Slower, but shown live as "thinking".
AETHER_THINK=false
AETHER_USER_NAME=

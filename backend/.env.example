# Copy to backend/.env. Every setting is optional.
AETHER_OLLAMA_URL=http://localhost:11434
AETHER_MODEL=qwen2.5:7b
AETHER_EMBED_MODEL=nomic-embed-text
AETHER_MAX_STEPS=8
AETHER_CONTEXT_LENGTH=16384
AETHER_TEMPERATURE=0.2
# Let reasoning models (qwen3, deepseek-r1) think out loud. Slower, but shown live as "thinking".
AETHER_THINK=false
AETHER_USER_NAME=
# Model used for images when the main one can't see ("" = any installed vision model)
AETHER_VISION_MODEL=
# Learn lasting facts about you after each answer
AETHER_AUTO_MEMORY=true
# External MCP tool servers (copy mcp_servers.example.json to mcp_servers.json)
AETHER_MCP_CONFIG=mcp_servers.json

# Other computers running Ollama on your network (e.g. a GPU PC), as JSON.
# Their models show up as "<model>@<name>". See pc/setup-ollama-pc.ps1.
# AETHER_OLLAMA_HOSTS={"pc": "http://192.168.1.50:11434"}

# --- Optional cloud brains (local stays the default) --------------------------
# Or paste keys in the web app: Settings → Cloud brains. Cloud models send your
# messages to that provider while selected; memory, documents and voice stay local.
# Free tiers:
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GITHUB_MODELS_TOKEN=
HF_TOKEN=
# Paid:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
# Use a cloud model by default, e.g. AETHER_MODEL=gemini:gemini-2.5-flash
